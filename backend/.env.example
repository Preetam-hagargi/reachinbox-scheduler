PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=reachinbox
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=change_me
# Prisma and backend PostgreSQL connection string.
DATABASE_URL=postgresql://reachinbox:change_me@localhost:5432/reachinbox

# BullMQ Redis connection. Redis is configured with AOF persistence in Docker Compose.
REDIS_URL=redis://localhost:6379

# SMTP configuration for Ethereal Email. Add your test account credentials locally.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Google OAuth web client configuration; register the redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Use a private random value of at least 32 characters. Sessions expire after 7 days by default.
SESSION_SECRET=
SESSION_TTL_SECONDS=604800
# Exact Google account email allowed to view the read-only BullMQ dashboard.
BULL_BOARD_ADMIN_EMAIL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/slack/oauth/callback
# Persistent random 32-byte key encoded as 64 hex characters; never commit a real key.
SLACK_TOKEN_ENCRYPTION_KEY=
ELASTICSEARCH_URL=http://localhost:9200
# Preferred tenant for first-time local Google users.
SEARCH_TENANT_ID=
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
